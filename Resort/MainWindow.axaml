<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		MinHeight="450"
		MinWidth="800"
        x:Class="Resort.MainWindow"
		x:CompileBindings="False"
		WindowStartupLocation="CenterScreen"
        Title="Добро пожаловать">
	<Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
		  ShowGridLines="False">
		<StackPanel Grid.Row="1"
					Margin="5">
			<Image Source="Assets\logo.png"
			   Height="70"/>
			<TextBlock Text="Приэльбрусье"
					   HorizontalAlignment="Center"
					   FontFamily="Bahnschrift"/>
		</StackPanel>
		<TextBlock Text="Неверный логин или пароль"
				   Grid.Row="2"
				   HorizontalAlignment="Center"
				   Foreground="Red"
				   IsVisible="False"
				   Name="attention"/>
		<TextBox Watermark="Логин"
				 Grid.Row="3"
				 Width="200"
				 HorizontalAlignment="Center"
				 Name="loginTB"/>
		<TextBox Watermark="Пароль"
				 Grid.Row="4"
				 Width="200"
				 HorizontalAlignment="Center"
				 Name="passwordTB"
				 PasswordChar="•"/>
		<TextBlock Grid.Row="6"
				   HorizontalAlignment="Center"
				   FontSize="34"
				   Name="captcha"
				   TextDecorations="Strikethrough"
				   IsVisible="False"/>
		<Button Grid.Row="7"
				Width="200"
				HorizontalAlignment="Center"
				Name="update"
				IsVisible="False"
				Background="#349C3D">
			<TextBlock Text="Я не понимаю"
					   HorizontalAlignment="Center"/>
		</Button>
		<TextBox Grid.Row="8"
				 Watermark="Введите символы"
				 Width="200"
				 HorizontalAlignment="Center"
				 Name="vvod"
				 IsVisible="False"/>
		<Button Grid.Row="9"
				Width="200"
				HorizontalAlignment="Center"
				Name="welcome"
				IsVisible="True"
				Background="#349C3D">
			<TextBlock Text="Войти"
					   HorizontalAlignment="Center"/>
		</Button>
		<Button Grid.Row="5"
				Width="200"
				HorizontalAlignment="Center"
				Name="iSeeYou"
				Background="Transparent">
			<TextBlock Text="Показать символы"
					   HorizontalAlignment="Center"/>
		</Button>
	</Grid>
</Window>